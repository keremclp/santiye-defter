# Şantiye Hesap ortam değişkenleri (şartname bölüm 2).
# Bu dosyayı depo kökünde .env adıyla kopyalayıp değerleri doldurun. Gerçek değerleri buraya yazmayın;
# .env commit edilmez. Geliştirmede boş bırakılan PORT, MONGODB_URI ve WEB_ORIGIN için API yerel
# varsayılanları kullanır (README).

# API portu; boşsa 3000
PORT=
# Ana veritabanı (replica set zorunlu)
MONGODB_URI=
# Demo veritabanı; gerçek veriden ayrı
MONGODB_DEMO_URI=

# Access token imzası, en az 32 karakter
JWT_ACCESS_SECRET=
# Refresh token imzası, access'ten farklı
JWT_REFRESH_SECRET=

# Belge depolama (S3 uyumlu). Yerelde docker compose MinIO bu değerlerle açılır:
# STORAGE_ACCESS_KEY en az 3, STORAGE_SECRET_KEY en az 8 karakter.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Ürün adı (Şantiye Hesap)
APP_NAME=
# CORS için web adresi
WEB_ORIGIN=
# Web'in API adresi
VITE_API_URL=
# Şifremi unuttum ve kapasite ekranlarında görünen ürün sahibi iletişim metni
SUPPORT_CONTACT_TEXT=

# İlk ürün sahibi hesabını bir kez oluşturmak için; ilk girişte TOTP kurulumu zorunlu
PLATFORM_BOOTSTRAP_USERNAME=
PLATFORM_BOOTSTRAP_PASSWORD=
# TOTP gizli anahtarlarını şifrelemek için (AES-256-GCM), en az 32 bayt
PLATFORM_TOTP_ENCRYPTION_KEY=
